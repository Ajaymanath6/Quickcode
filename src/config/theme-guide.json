  "componentGuidelines": {
    "button": {
      "cornerRadius": {
        "value": "6px",
        "tailwindClass": "rounded-md",
        "description": "ALL buttons use rounded-md (6px)."
      },
      "secondaryBorderWidth": {
        "value": "1.5px",
        "tailwindClass": "border-[1.5px]",
        "description": "Secondary buttons use 1.5px borders."
      },
      "primary": {
        "description": "Main CTA",
        "completeClasses": "border-[1.5px] border-transparent bg-brandcolor-primary text-brandcolor-white hover:bg-brandcolor-primaryhover focus:border-brandcolor-primary active:border-brandcolor-primary active:shadow-button-press disabled:opacity-50 rounded-md",
        "requiredClasses": [
          "border-[1.5px]",
          "border-transparent",
          "bg-brandcolor-primary",
          "text-brandcolor-white",
          "hover:bg-brandcolor-primaryhover",
          "rounded-md"
        ],
        "whenToUse": "Primary call-to-action"
      },
      "neutral": {
        "description": "Neutral / outline",
        "completeClasses": "border-[1.5px] border-brandcolor-strokelight text-brandcolor-textweak bg-brandcolor-white hover:bg-brandcolor-neutralhover active:border-brandcolor-textweak active:shadow-button-press disabled:opacity-50 rounded-md",
        "requiredClasses": [
          "border-[1.5px]",
          "border-brandcolor-strokelight",
          "text-brandcolor-textweak",
          "bg-brandcolor-white",
          "hover:bg-brandcolor-neutralhover",
          "rounded-md"
        ],
        "whenToUse": "Neutral actions"
      }
    },
    "card": {
      "description": "Cards with weak stroke",
      "styling": {
        "border": "border border-brandcolor-strokeweak",
        "background": "bg-brandcolor-white",
        "padding": "p-card-pad-default",
        "borderRadius": "rounded-lg",
        "shadow": "shadow-card"
      },
      "criticalRules": [
        "ALWAYS use border-brandcolor-strokeweak for card borders",
        "ALWAYS use bg-brandcolor-white for card background",
        "Prefer p-card-pad-default / gap-card-gap-default spacing tokens"
      ]
    },
    "heading": {
      "h1": {
        "classes": "text-brandcolor-textstrong text-theme-title-h1 font-theme-bold"
      },
      "h2": {
        "classes": "text-brandcolor-textstrong text-theme-title-h2 font-theme-semibold"
      },
      "h3": {
        "classes": "text-brandcolor-textstrong text-theme-title-h3 font-theme-semibold"
      }
    },
    "input": {
      "description": "Inputs with strong stroke; focus to textstrong; no rings",
      "classes": "border-brandcolor-strokestrong focus:border-brandcolor-textstrong focus:outline-none focus:ring-0 text-brandcolor-textstrong",
      "criticalRules": [
        "ALWAYS include focus:ring-0 and focus:outline-none",
        "Focus border MUST be brandcolor-textstrong"
      ]
    }
  },
  "aiInstructions": {
    "workflow": [
      "STEP 1: Read Tailwind brandcolor-* tokens",
      "STEP 2: Read this theme-guide.json completely",
      "STEP 3: Check componentGuidelines for the component",
      "STEP 4: Emit ONLY brandcolor-* / theme spacing utilities",
      "STEP 5: No hex, no inline styles, no bg-blue-*"
    ],
    "criticalRules": {
      "noHexCodes": {
        "rule": "NEVER use hex color codes in HTML/CSS/inline styles",
        "severity": "CRITICAL"
      },
      "noInlineStyles": {
        "rule": "NEVER use style= for colors",
        "severity": "CRITICAL"
      },
      "noHardcodedTailwindColors": {
        "rule": "NEVER use bg-blue-600 / text-gray-900 / border-gray-200",
        "severity": "CRITICAL",
        "examples": {
          "wrong": [
            "bg-blue-700",
            "text-gray-900"
          ],
          "correct": [
            "bg-brandcolor-primary",
            "text-brandcolor-textstrong"
          ]
        }
      },
      "onlyUtilityClasses": {
        "rule": "ONLY use utilities from this guide and tailwind.config.js",
        "severity": "CRITICAL"
      }
    },
    "commonMistakes": {
      "mistake1": {
        "wrong": "<button class=\"bg-blue-600 text-white\">Button</button>",
        "correct": "<button class=\"bg-brandcolor-primary text-brandcolor-white hover:bg-brandcolor-primaryhover rounded-md px-4 py-2\">Button</button>",
        "reason": "Use theme classes and required button radius"
      },
      "mistake2": {
        "wrong": "<div style=\"background-color: #F84416\">Content</div>",
        "correct": "<div class=\"bg-brandcolor-primary\">Content</div>",
        "reason": "No inline styles or hex"
      },
      "mistake3": {
        "wrong": "<button class=\"bg-brandcolor-primary rounded-lg\">Button</button>",
        "correct": "<button class=\"bg-brandcolor-primary rounded-md\">Button</button>",
        "reason": "Buttons must use rounded-md"
      }
    }
  }
}
